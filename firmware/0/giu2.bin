it fetch('/hp-firmware',{method:'POST',body:f.files[0]});s.textContent=await r.text()}catch(e){s.textContent=e.message}finally{b.disabled=false}}</script></html>␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ёЏ<1.1.1.1␀␀␀␀␀␀␀␀␀wifi_start␀␀<!doctype html><html lang=vi><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'><title>Vi TГ­nh An PhГє В· Thiбєїt lбє­p</title><style>*{box-sizing:border-box}html{color-scheme:dark}body{font:15px/1.6 system-ui;max-width:760px;margin:0 auto;padding:32px 18px 24px;background:#080f1d;color:#ecf3ff}body:before{content:"";position:fixed;inset:0;pointer-events:none;background:radial-gradient(ellipse at 90% 0, #16395166,transparent 60%);z-index:-1}header{padding:20px 4px 26px}h1{font-size:34px;line-height:1.2;letter-spacing:-1px;margin:12px 0}h2{font-size:19px;margin:0 0 8px}p{color:#a9bad1;margin:8px 0 18px}.eyebrow{color:#65e3cc;font-size:12px;font-weight:750;letter-spacing:2px}.card{padding:24px;margin:0 0 18px;background:linear-gradient(145deg,#17253a,#101c2d);border:1px solid #2c405a;border-radius:22px;box-shadow:0 16px 35px #0003}.step{display:inline-grid;place-items:center;width:29px;height:29px;border-radius:10px;background:#63e6cb22;color:#70efdb;font-size:13px;margin-right:8px}input,select,button{box-sizing:border-box;width:100%;min-height:48px;padding:12px 14px;border-radius:12px;border:1px solid #354c68;background:#0c1728;color:#eff6ff;font:inherit}input:focus,select:focus{outline:2px solid #63e6cb;border-color:transparent}label{display:block;margin:16px 0 0;color:#c5d4e7}label input,label select{margin-top:7px}button{background:#6ce6cc;color:#071c22;border-color:transparent;font-weight:750;cursor:pointer;margin:16px 0 8px}button:hover{filter:brightness(1.08)}button:disabled{opacity:.55;cursor:wait}#scan{background:#20364d;color:#8ff2e0;border:1px solid #395c72}a{color:#82ebd7;text-underline-offset:4px}#status:empty,#result:empty{display:none}#status{padding:16px;border:1px solid #345870;background:#112b3d;border-radius:14px;color:#d5e8ff}#result{padding:24px;background:#11372e;border:1px solid #53c9a5;border-radius:18px;margin:18px 0}#result a{display:block;font-size:25px;font-weight:800;overflow-wrap:anywhere}#result p{color:#d9f3e9;margin:12px 0 0}footer{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;padding:20px 4px;color:#8fa3be;font-size:12px}details summary{cursor:pointer;color:#cad8eb}.hint{font-size:13px}[hidden]{display:none!important}@media(max-width:480px){body{padding:14px 12px}.card{padding:18px}h1{font-size:28px}#result a{font-size:21px}}</style><header><span class=eyebrow>VI TГЌNH AN PHГљ / KбєѕT Nб»ђI KHГ”NG DГ‚Y</span><h1>MГЎy in cЕ©. TrбєЈi nghiб»‡m mб»›i.</h1><p>Kбєїt nб»‘i Wi-Fi lбє§n Д‘бє§u hoбє·c Д‘б»•i tГЄn mбєЎng vГ  mбє­t khбє©u.</p><p><a href='/'>Trang in</a></p></header><form id=form><section class=card><h2><span class=step>01</span>Kбєїt nб»‘i Wi-Fi nhГ  bбєЎn</h2><p class=hint>Chб»‰ tГ¬m Wi-Fi 2.4 GHz В· MбєЎng mбєЎnh nhбєҐt б»џ Д‘бє§u danh sГЎch.</p><p id=info>Дђang Д‘б»Ќc trбєЎng thГЎi Wi-FiвЂ¦</p><p class=hint>Nбєїu Wi-Fi cЕ© Д‘ГЈ Д‘б»•i tГЄn hoбє·c mбє­t khбє©u, giб»Ї BOOT 5 giГўy, kбєїt nб»‘i vГ o Wi-Fi <strong>ViTinhAnPhu-XXXX</strong> cб»§a ESP, rб»“i mб»џ <strong>http://192.168.4.1/setup</strong>.</p><button id=scan type=button disabled>TГ¬m mбєЎng Wi-Fi 2.4 GHz</button><select id=networks aria-label='MбєЎng tГ¬m thбєҐy'><option>Chб»Ќn mбєЎng hoбє·c nhбє­p tГЄn bГЄn dЖ°б»›i</option></select><label>TГЄn Wi-Fi<input id=ssid required maxlength=32 autocomplete=off></label><label>Mбє­t khбє©u Wi-Fi<input id=password type=password maxlength=63 autocomplete=new-password></label></section><button id=save disabled>Kбєїt nб»‘i Wi-Fi</button></form><p id=status role=status></p><div id=result></div><p>ESP tб»± nhбє­n IP tб»« router khi kбєїt nб»‘i Wi-Fi. Sau khi kбєїt nб»‘i, anh cГі thб»ѓ mб»џ mб»Ґc <strong>Дђб»‹a chб»‰ IP</strong> trГЄn trang in Д‘б»ѓ giб»Ї Д‘б»‹a chб»‰ Д‘Гі lГ m IP tД©nh.</p><details class=card><summary>BГ n giao thiбєїt bб»‹ cho khГЎch</summary><p>XГіa Wi-Fi vГ  IP Д‘ГЈ thб»­, giб»Ї firmware HP. Giб»Ї BOOT 5 giГўy rб»“i bбєҐm nГєt bГЄn dЖ°б»›i.</p><button id=handover type=button>BГ n giao В· xГіa Wi-Fi Д‘ГЈ lЖ°u</button></details><footer><span>Vi TГ­nh An PhГє</span><span id=firmware>Дђang Д‘б»Ќc phiГЄn bбєЈnвЂ¦</span><a href='/licenses'>GiбєҐy phГ©p mГЈ nguб»“n mб»џ</a></footer>
<script>
const $=id=>document.getElementById(id);
let waiting=false, submitting=false, scanning=false, ap=false, scanned=false, connected=false, busy=false;
function buttons(){
  $('scan').disabled=(!ap&&!connected)||busy||waiting||submitting||scanning;
  $('save').disabled=(!ap&&!connected)||busy||waiting||submitting||scanning;
}
$('networks').onchange=()=>{$('ssid').value=$('networks').value};
$('scan').onclick=async()=>{
  if((!ap&&!connected)||busy||scanning||submitting||waiting)return;
  scanning=true;
  buttons();
  $('status').textContent='Дђang tГ¬m Wi-Fi 2.4 GHzвЂ¦';
  try{
    const r=await fetch('/api/setup/scan',{cache:'no-store'});
    const j=await r.json();
    if(!r.ok)throw Error(j.message);
    const seen=new Set();
    const networks=j.networks.filter(n=>n.ssid&&(!n.channel||n.channel<=14))
      .sort((a,b)=>b.rssi-a.rssi).filter(n=>{
        if(seen.has(n.ssid))return false;
        seen.add(n.ssid);
        return true;
      });
    $('networks').replaceChildren();
    const placeholder=document.createElement('option');
    placeholder.value='';
    placeholder.textContent=networks.length?'Chб»Ќn Wi-Fi nhГ  bбєЎn ('+networks.length+' mбєЎng)':'KhГґng thбєҐy mбєЎng В· Nhбє­p tГЄn bГЄn dЖ°б»›i';
    $('networks').append(placeholder);
    for(const n of networks){
      const option=document.createElement('option');
      option.value=n.ssid;
      option.textContent=n.ssid+' ('+n.rssi+' dBm)'+(n.rssi>=-60?' В· SГіng mбєЎnh':'');
      $('networks').append(option);
    }
    $('status').textContent=networks.length?'':'KhГґng thбєҐy mбєЎng 2.4 GHz. CГі thб»ѓ nhбє­p tГЄn mбєЎng thб»§ cГґng.';
  }catch(e){$('status').textContent=e.message}
  finally{
    scanning=false;
    $('scan').textContent='QuГ©t lбєЎi Wi-Fi 2.4 GHz';
    buttons();
  }
};
$('form').onsubmit=async e=>{
  e.preventDefault();
  if($('save').disabled)return;
  submitting=true;
  buttons();
  $('result').replaceChildren();
  try{
    const data={ssid:$('ssid').value,password:$('password').value,mode:'dhcp'};
    const r=await fetch('/api/setup',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
    const j=await r.json();
    if(!r.ok)throw Error(j.message);
    waiting=true;
    $('status').textContent=j.message+' Nбєїu trang mбєҐt kбєїt nб»‘i, chuyб»ѓn sang Wi-Fi mб»›i vГ  mб»џ lбєЎi trang in. Nбєїu thбєҐt bбєЎi, ESP sбєЅ quay vб»Ѓ Wi-Fi cЕ©.';
  }catch(e){
    $('status').textContent=e.message;
  }finally{
    submitting=false;
    buttons();
  }
};
async function poll(){
  try{
    const r=await fetch('/api/setup/status',{cache:'no-store'});
    const j=await r.json();
    $('firmware').textContent='Firmware '+(j.firmware||'вЂ”');
    ap=j.ap;
    connected=j.connected;
    busy=!!(j.pending||j.busy);
    buttons();
    $('info').textContent=ap?'Wi-Fi thiбєїt lбє­p: '+j.ap_name:connected?'Дђang dГ№ng Wi-Fi hiб»‡n tбєЎi. Chб»Ќn mбєЎng mб»›i bГЄn dЖ°б»›i Д‘б»ѓ Д‘б»•i Wi-Fi.':'ChЖ°a cГі kбєїt nб»‘i. Giб»Ї BOOT 5 giГўy Д‘б»ѓ mб»џ Wi-Fi thiбєїt lбє­p.';
    if((ap||connected)&&!busy&&!scanned&&!waiting&&!submitting){
      scanned=true;
      $('scan').onclick();
    }else if(!ap&&!connected)scanned=false;
    if(!waiting)return;
    if(j.pending)return;
    if(j.error){
      waiting=false;
      $('status').textContent='ChЖ°a kбєїt nб»‘i/lЖ°u Д‘Ж°б»Јc. Kiб»ѓm tra tГЄn Wi-Fi hoбє·c mбє­t khбє©u rб»“i thб»­ lбєЎi.';
    }else if(j.connected&&j.ip){
      waiting=false;
      $('password').value='';
      $('status').textContent='ДђГЈ kбєїt nб»‘i vГ  lЖ°u Wi-Fi. Chuyб»ѓn Д‘iб»‡n thoбєЎi vб»Ѓ Wi-Fi nhГ  Д‘б»ѓ mб»џ trang in hoбє·c giб»Ї IP nГ y lГ m IP tД©nh.';
      const base='http://'+j.ip;
      const print=document.createElement('a');
      print.href=base+'/';
      print.textContent=print.href;
      const fixed=document.createElement('a');
      fixed.href=base+'/network';
      fixed.textContent='Chб»Ќn IP tД©nh cho '+j.ip;
      $('result').replaceChildren(print,fixed);
    }
    buttons();
  }catch(e){
    if(waiting)$('status').textContent='Дђang Д‘б»•i Wi-Fi. Chuyб»ѓn sang mбєЎng mб»›i rб»“i mб»џ lбєЎi trang in; nбєїu thбєҐt bбєЎi, ESP sбєЅ quay vб»Ѓ Wi-Fi cЕ©. CГі thб»ѓ kбєїt nб»‘i hotspot ViTinhAnPhu-XXXX Д‘б»ѓ kiб»ѓm tra.';
  }
}
setInterval(poll,2000);
poll();
$('handover').onclick=async()=>{
  if(!confirm('XГіa Wi-Fi/IP Д‘ГЈ lЖ°u Д‘б»ѓ bГ n giao cho khГЎch?'))return;
  try{
    const r=await fetch('/api/setup/handover',{method:'POST'});
    $('status').textContent=(await r.json()).message;
  }catch(e){$('status').textContent=e.message}
};
</script></html>
␀␀␀<!doctype html><html lang=vi><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'><title>GiбєҐy phГ©p mГЈ nguб»“n mб»џ</title><style>body{font:16px/1.55 system-ui;max-width:720px;margin:30px auto;padding:20px;background:#f1f6f7;color:#173239}a{color:#087e81}li{margin:6px 0}</style><h1>GiбєҐy phГ©p mГЈ nguб»“n mб»џ</h1><p><a href='/'>Trang in</a></p><p>Firmware nГ y lГ  phбє§n mб»Ѓm tб»± do, phГўn phб»‘i theo giбєҐy phГ©p <b>GNU GPL phiГЄn bбєЈn 3 hoбє·c mб»›i hЖЎn</b>, <b>khГґng cГі bбєҐt kб»і bбєЈo hГ nh nГ o</b>. BбєЎn cГі quyб»Ѓn nhбє­n mГЈ nguб»“n tЖ°ЖЎng б»©ng cб»§a bбєЈn firmware nГ y tб»« ngЖ°б»ќi cung cбєҐp thiбєїt bб»‹. ToГ n vДѓn giбєҐy phГ©p: <a href='https://www.gnu.org/licenses/gpl-3.0.html' target=_blank rel=noopener>gnu.org/licenses/gpl-3.0</a>.</p><p>XГўy dб»±ng tб»« cГЎc dб»± ГЎn mГЈ nguб»“n mб»џ:</p><ul><li>esp32-lbp2900-airprint (GPL-3.0-or-later)</li><li>esp32-usb-to-airprint, В© Xuan-Son Nguyen (MIT)</li><li>captdriver: driver Canon CAPT (GPL)</li><li>brlaser, В© Peter De Wachter: Brother laser (GPL-2.0-or-later)</li><li>JBIG-KIT, В© Markus Kuhn (GPL)</li><li>ESP-IDF, В© Espressif Systems (Apache-2.0)</li></ul><p>Dб»Ї liб»‡u khб»џi Д‘б»™ng mГЎy in HP P1006 (tбєЈi tб»« Internet khi cбє§n) lГ  thГ nh phбє§n nhб»‹ phГўn cб»§a HP, theo Д‘iб»Ѓu khoбєЈn riГЄng, khГґng thuб»™c giбєҐy phГ©p GPL.</p></html>␀␀␀␀<!doctype html><html lang=vi><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'><title>Vi TГ­nh An PhГє В· PhiГЄn bбєЈn</title><style>body{font:17px system-ui;max-width:650px;margin:30px auto;padding:20px;background:#f1f6f7;color:#173239}a{color:#087e81}</style><h1>Vi TГ­nh An PhГє</h1><p><a href='/'>Trang in</a> В· <a href='/licenses'>GiбєҐy phГ©p mГЈ nguб»“n mб»џ</a></p><h2>PhiГЄn bбєЈn firmware</h2><p id=version>Дђang Д‘б»ЌcвЂ¦</p><p>Cбє­p nhбє­t qua mбєЎng Д‘ГЈ tбєЇt trГЄn bбєЈn nГ y. Дђб»ѓ cбє­p nhбє­t: cбєЇm board vГ o mГЎy tГ­nh bбє±ng cГЎp USB (cб»•ng COM), mб»џ phбє§n mб»Ѓm <b>NбєЎp Firmware - Vi TГ­nh An PhГє</b> vГ  chб»Ќn <b>Cбє­p nhбє­t, giб»Ї WiFi</b>. Wi-Fi, IP vГ  firmware HP Д‘ГЈ lЖ°u Д‘Ж°б»Јc giб»Ї nguyГЄn.</p><script>fetch('/api/update',{cache:'no-store'}).then(r=>r.json()).then(s=>{document.getElementById('version').textContent='Дђang dГ№ng: '+s.current+' В· '+s.profile}).catch(()=>{})</script></html>␀␀␀␀255.255.255.0␀␀␀␀␀␀␀␀␀␀␀1.1.1.1␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀<!doctype html><html lang=vi><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'><title>CГ i Д‘бє·t IP ESP 32</title><style>body{font:17px system-ui;max-width:620px;margin:30px auto;padding:20px;background:#f3f7fa}label{display:block;margin:14px 0}input,select,button{font:inherit;padding:10px;box-sizing:border-box;width:100%;border:1px solid #acbdc8;border-radius:8px}button{background:#087e81;color:white}a{color:#087e81}small{display:block}</style><nav><a href='/'>Trang in</a> В· <a href='/setup'>Дђб»•i Wi-Fi</a></nav>
<h1>Дђб»‹a chб»‰ IP</h1>
<p id=current>Дђang Д‘б»Ќc Д‘б»‹a chб»‰ IPвЂ¦</p>
<form id=form>
<label>Chбєї Д‘б»™ IP<select id=mode disabled><option value=dhcp>IP Д‘б»™ng (DHCP)</option><option value=static>IP tД©nh вЂ” giб»Ї IP Д‘ang dГ№ng</option></select></label>
<p id=preview></p>
<button id=save disabled>LЖ°u chбєї Д‘б»™ IP</button>
</form>
<p id=status role=status></p>
<script>
const $=id=>document.getElementById(id);
let current='', loaded=false, saving=false;
function render(){
  const fixed=$('mode').value==='static';
  $('preview').textContent=fixed
    ? (current ? 'ESP sбєЅ giб»Ї IP '+current+' lГ m IP tД©nh.' : 'ESP chЖ°a nhбє­n IP tб»« router.')
    : 'Router sбєЅ tб»± cбєҐp IP cho ESP.';
  $('save').disabled=!loaded||saving||(fixed&&!current);
}
$('mode').onchange=render;
fetch('/api/network',{cache:'no-store'}).then(async r=>{
  if(!r.ok)throw Error('KhГґng Д‘б»Ќc Д‘Ж°б»Јc cбєҐu hГ¬nh IP.');
  const config=await r.json();
  current=config.current;
  $('current').textContent=current?'IP Д‘ang dГ№ng: '+current:'ESP chЖ°a cГі Д‘б»‹a chб»‰ IP.';
  $('mode').value=config.mode;
  $('mode').disabled=false;
  loaded=true;
  render();
}).catch(e=>$('status').textContent=e.message);
$('form').onsubmit=async e=>{
  e.preventDefault();
  if($('save').disabled)return;
  saving=true;
  render();
  $('status').textContent='Дђang lЖ°uвЂ¦';
  try{
    const r=await fetch('/api/network',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({mode:$('mode').value})});
    const config=await r.json();
    if(!r.ok)throw Error(config.message);
    $('status').textContent=config.message;
    if(config.url){
      const link=document.createElement('a');
      link.href=config.url;
      link.textContent=' Mб»џ trang in';
      $('status').append(link);
    }
  }catch(e){
    $('status').textContent=e.message;
    saving=false;
    render();
  }
};
</script></html>
␀<!doctype html><html lang=vi><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'><title>Nhбє­t kГЅ mГЎy in</title><style>body{font:16px system-ui;margin:0;background:#f1f5f9;color:#163044}main{max-width:1000px;margin:auto;padding:24px}a,button{display:inline-block;padding:12px 16px;margin:4px;border:0;border-radius:10px;background:#087e81;color:white;text-decoration:none;font:inherit;cursor:pointer}pre{background:#102332;color:#e6f5f3;padding:16px;border-radius:12px;white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.6 monospace}label{display:block;margin:16px 0}</style><main><a href='/'>в†ђ Trang in</a><h1>Nhбє­t kГЅ vГ  chбє©n Д‘oГЎn</h1><p>Log tб»± thu khi ESP khб»џi Д‘б»™ng. Nбєїu in lб»—i, tбєЈi bГЎo cГЎo rб»“i gб»­i lбєЎi Д‘б»ѓ kiб»ѓm tra.</p><a href='/diagnostics.txt' download='printserver-log.txt'>TбєЈi bГЎo cГЎo lб»—i (.txt)</a><button id=refresh>LГ m mб»›i</button><a href='/diagnostics/coredump' download='printserver-crash.elf'>TбєЈi crash dump</a><label><input type=checkbox id=auto checked> Tб»± cбє­p nhбє­t mб»—i 3 giГўy</label><p>Log giб»Ї phбє§n gбє§n nhбєҐt trong bб»™ Д‘б»‡m vГІng 64 KB. ДђuГґi log cГі thб»ѓ cГІn sau reset/watchdog; mбєҐt Д‘iб»‡n sбєЅ mбєҐt log RAM. HГЈy tбєЈi trЖ°б»›c khi rГєt nguб»“n. Crash dump chб»‰ cГі nбєїu ESP Д‘ГЈ ghi Д‘Ж°б»Јc mб»™t lбє§n crash.</p><p id=status>Дђang Д‘б»ЌcвЂ¦</p><pre id=report></pre></main><script>const report=document.getElementById('report'),statusEl=document.getElementById('status'),refresh=document.getElementById('refresh');let busy=false;async function update(){if(busy)return;busy=true;try{const r=await fetch('/diagnostics.txt',{cache:'no-store'});if(!r.ok)throw Error('HTTP '+r.status);report.textContent=await r.text();statusEl.textContent='Cбє­p nhбє­t: '+new Date().toLocaleTimeString()}catch(e){statusEl.textContent='KhГґng Д‘б»Ќc Д‘Ж°б»Јc log: '+e.message}finally{busy=false}}refresh.onclick=update;setInterval(()=>{if(document.getElementById('auto').checked)update()},3000);update();</script></html>␀␀␀␀®ХЂЁ?У␀@Ќ ЎИЪЃПЩсЫ@.¤¦␀␀␀␀␀␀␀␀␀␀␀usb_parse_endpoint_descriptor_by_address␀␀␀␀usb_parse_endpoint_descriptor_by_index␀␀usb_parse_interface_descriptor␀␀usb_parse_next_descriptor_of_type␀␀␀usb_parse_next_descriptor␀␀␀d¬B␀␀␀␀TЇB␀␀␀␀d¬B␀␀␀␀x­B␀␀␀␀d¬B␀␀␀␀®B␀␀␀␀usb_host_transfer_submit␀␀␀␀usb_host_interface_release␀␀interface_free␀␀ep_wrapper_free␀usb_host_interface_claim␀␀␀␀usb_host_device_close␀␀␀usb_host_device_open␀␀␀␀_handle_pending_ep␀␀usb_host_client_handle_events␀␀␀usb_host_lib_handle_events␀␀_check_client_opened_device␀usbh_event_callback␀enum_event_callback␀hub_event_callback␀␀usb_host_install␀␀␀␀usbh_ep_get_context␀endpoint_free␀␀␀get_ep_from_addr␀␀␀␀usbh_dev_enum_unlock␀␀␀␀usbh_dev_close␀␀device_free␀handle_ep0_flush␀␀␀␀handle_epn_halt_flush␀␀␀usbh_uninstall␀␀usb_phy_get_phy_status␀␀usb_del_phy␀phy_otg_iopins_configure␀␀␀␀phy_configure_pin_output␀␀␀␀phy_configure_pin_input␀phy_external_iopins_configure␀␀␀usb_phy_install␀usb_new_phy␀usb_new_phy␀usb_phy_otg_set_mode␀␀␀␀usb_phy_otg_set_mode␀␀␀␀hcd_urb_dequeue␀_internal_pipe_event_wait␀␀␀_pipe_cmd_halt␀␀pipe_alloc_hcd_support_verification␀_internal_port_event_wait␀␀␀usb_dwc_hal_port_periodic_enable␀␀␀␀_internal_port_event_notify_from_isr␀␀␀␀_internal_pipe_event_notify␀_buffer_parse_intr␀␀_buffer_parse_bulk␀␀_buffer_parse_isoc␀␀_buffer_parse_ctrl␀␀_buffer_parse␀␀␀_buffer_fill_intr␀␀␀_buffer_fill_isoc␀␀␀_buffer_fill␀␀␀␀_buffer_exec␀␀␀␀usb_dwc_hal_chan_set_dir␀␀␀␀_buffer_exec_cont␀␀␀_intr_hdlr_chan␀set_next_stage␀␀stage_complete␀␀stage_cancel␀␀␀␀get_next_free_dev_addr␀␀enum_cancel␀enum_start␀␀enum_control_transfer_complete␀␀ёК<АК<ФК<мК<ьК<Л< Л<,Л<@Л<TЛ<hЛ<xЛ<ђЛ<ЁЛ<АЛ<ШЛ<рЛ<М<$М<<М<TМ<pМ<€М<¤М<јМ<ШМ<рМ<Н<$Н<@Н<XН<pН<|Н<ЊН<Н<root_port_req␀␀␀dev_tree_node_new␀␀␀root_port_handle_events␀hub_dev_new␀hub_port_recycle␀␀␀␀hub_root_stop␀␀␀hub_uninstall␀␀␀root_port_callback␀␀hub_install␀А␀␀␀␀␀␀␀%-12345X␀␀␀%-12345X@PJL ENTER LANGUAGE=ACL
