it fetch('/hp-firmware',{method:'POST',body:f.files[0]});s.textContent=await r.text()}catch(e){s.textContent=e.message}finally{b.disabled=false}}</script></html>␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀МЏ<1.1.1.1␀␀␀␀␀␀␀␀␀Р␀␀€␀␀'␀␀wifi_start␀␀<!doctype html><html lang=vi><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'><title>Vi TГ­nh An PhГє В· Thiбєїt lбє­p</title><style>*{box-sizing:border-box}html{color-scheme:dark}body{font:15px/1.6 system-ui;max-width:760px;margin:0 auto;padding:32px 18px 24px;background:#080f1d;color:#ecf3ff}body:before{content:"";position:fixed;inset:0;pointer-events:none;background:radial-gradient(ellipse at 90% 0, #16395166,transparent 60%);z-index:-1}header{padding:20px 4px 26px}h1{font-size:34px;line-height:1.2;letter-spacing:-1px;margin:12px 0}h2{font-size:19px;margin:0 0 8px}p{color:#a9bad1;margin:8px 0 18px}.eyebrow{color:#65e3cc;font-size:12px;font-weight:750;letter-spacing:2px}.card{padding:24px;margin:0 0 18px;background:linear-gradient(145deg,#17253a,#101c2d);border:1px solid #2c405a;border-radius:22px;box-shadow:0 16px 35px #0003}.step{display:inline-grid;place-items:center;width:29px;height:29px;border-radius:10px;background:#63e6cb22;color:#70efdb;font-size:13px;margin-right:8px}input,select,button{box-sizing:border-box;width:100%;min-height:48px;padding:12px 14px;border-radius:12px;border:1px solid #354c68;background:#0c1728;color:#eff6ff;font:inherit}input:focus,select:focus{outline:2px solid #63e6cb;border-color:transparent}label{display:block;margin:16px 0 0;color:#c5d4e7}label input,label select{margin-top:7px}button{background:#6ce6cc;color:#071c22;border-color:transparent;font-weight:750;cursor:pointer;margin:16px 0 8px}button:hover{filter:brightness(1.08)}button:disabled{opacity:.55;cursor:wait}#scan{background:#20364d;color:#8ff2e0;border:1px solid #395c72}a{color:#82ebd7;text-underline-offset:4px}#status:empty,#result:empty{display:none}#status{padding:16px;border:1px solid #345870;background:#112b3d;border-radius:14px;color:#d5e8ff}#result{padding:24px;background:#11372e;border:1px solid #53c9a5;border-radius:18px;margin:18px 0}#result a{display:block;font-size:25px;font-weight:800;overflow-wrap:anywhere}#result p{color:#d9f3e9;margin:12px 0 0}footer{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;padding:20px 4px;color:#8fa3be;font-size:12px}details summary{cursor:pointer;color:#cad8eb}.hint{font-size:13px}[hidden]{display:none!important}@media(max-width:480px){body{padding:14px 12px}.card{padding:18px}h1{font-size:28px}#result a{font-size:21px}}</style><header><span class=eyebrow>VI TГЌNH AN PHГљ / CГЂI Дђбє¶T Mбє NG</span><h1>CГ i Д‘бє·t Wi-Fi</h1><p>Kбєїt nб»‘i thiбєїt bб»‹ in vГ o mбєЎng Wi-Fi hoбє·c thay Д‘б»•i mбєЎng Д‘ang dГ№ng.</p><p><a href='/'>в†ђ Vб»Ѓ trang in</a></p></header><form id=form><section class=card><h2><span class=step>01</span>Chб»Ќn mбєЎng Wi-Fi</h2><p class=hint>Thiбєїt bб»‹ chб»‰ hб»— trб»Ј Wi-Fi 2.4 GHz. Danh sГЎch xбєїp theo cЖ°б»ќng Д‘б»™ tГ­n hiб»‡u.</p><p id=info>Дђang Д‘б»Ќc trбєЎng thГЎi Wi-FiвЂ¦</p><p class=hint>Nбєїu mбєЎng Wi-Fi Д‘ГЈ Д‘б»•i tГЄn hoбє·c mбє­t khбє©u: giб»Ї nГєt BOOT 5 giГўy, kбєїt nб»‘i vГ o Д‘iб»ѓm phГЎt <strong>ViTinhAnPhu-XXXX</strong> <span class=appwnote>(mбє­t khбє©u 12345678)</span>, rб»“i mб»џ <strong>http://192.168.4.1/setup</strong>.</p><button id=scan type=button disabled>TГ¬m mбєЎng Wi-Fi</button><select id=networks aria-label='MбєЎng tГ¬m thбєҐy'><option>Chб»Ќn mбєЎng Wi-Fi</option></select><label>TГЄn mбєЎng (SSID)<input id=ssid required maxlength=32 autocomplete=off></label><label>Mбє­t khбє©u<input id=password type=password maxlength=63 autocomplete=new-password></label></section><button id=save disabled>LЖ°u vГ  kбєїt nб»‘i</button></form><p id=status role=status></p><div id=result></div><p>Thiбєїt bб»‹ nhбє­n Д‘б»‹a chб»‰ IP tб»± Д‘б»™ng (DHCP). Sau khi kбєїt nб»‘i, cГі thб»ѓ Д‘бє·t IP tД©nh tбєЎi mб»Ґc <strong>CГ i Д‘бє·t IP</strong> trГЄn trang in.</p><details class=card><summary>BГ n giao thiбєїt bб»‹</summary><p>XГіa mбєЎng Wi-Fi, cГ i Д‘бє·t IP vГ  mбє­t khбє©u Д‘iб»ѓm phГЎt Д‘ГЈ lЖ°u; giб»Ї nguyГЄn firmware mГЎy in HP. Giб»Ї nГєt BOOT 5 giГўy trЖ°б»›c khi thб»±c hiб»‡n.</p><button id=handover type=button>XГіa cГ i Д‘бє·t mбєЎng</button></details><details class=card id=appw><summary>Mбє­t khбє©u Д‘iб»ѓm phГЎt</summary><p>Mбє­t khбє©u mбє·c Д‘б»‹nh: 12345678. NГЄn Д‘б»•i mбє­t khбє©u (8вЂ“63 kГЅ tб»±) Д‘б»ѓ chб»‰ ngЖ°б»ќi Д‘Ж°б»Јc cбєҐp mб»›i kбєїt nб»‘i vГ  in Д‘Ж°б»Јc. Giб»Ї nГєt BOOT 5 giГўy trЖ°б»›c khi lЖ°u.</p><p id=appwstate class=hint></p><label>Mбє­t khбє©u mб»›i<input id=appass type=password minlength=8 maxlength=63 autocomplete=new-password></label><button id=appsave type=button>LЖ°u mбє­t khбє©u</button><button id=appclear type=button>KhГґi phб»Ґc mбє·c Д‘б»‹nh</button><p class=hint>Sau khi lЖ°u, cГЎc thiбєїt bб»‹ Д‘ang kбєїt nб»‘i vГ o Д‘iб»ѓm phГЎt sбєЅ bб»‹ ngбєЇt vГ  cбє§n kбєїt nб»‘i lбєЎi.</p></details><footer><span>Vi TГ­nh An PhГє</span><span id=firmware>Дђang Д‘б»Ќc phiГЄn bбєЈnвЂ¦</span><a href='/licenses'>GiбєҐy phГ©p mГЈ nguб»“n mб»џ</a></footer>
<script>
const $=id=>document.getElementById(id);
const DEFAULT_PW='12345678';
let waiting=false, submitting=false, scanning=false, ap=false, scanned=false, connected=false, busy=false;
function buttons(){
  $('scan').disabled=(!ap&&!connected)||busy||waiting||submitting||scanning;
  $('save').disabled=(!ap&&!connected)||busy||waiting||submitting||scanning;
}
$('networks').onchange=()=>{$('ssid').value=$('networks').value};
$('scan').onclick=async()=>{
  if((!ap&&!connected)||busy||scanning||submitting||waiting)return;
  scanning=true;
  buttons();
  $('status').textContent='Дђang tГ¬m mбєЎng Wi-Fi 2.4 GHzвЂ¦';
  try{
    const r=await fetch('/api/setup/scan',{cache:'no-store'});
    const j=await r.json();
    if(!r.ok)throw Error(j.message);
    const seen=new Set();
    const networks=j.networks.filter(n=>n.ssid&&(!n.channel||n.channel<=14))
      .sort((a,b)=>b.rssi-a.rssi).filter(n=>{
        if(seen.has(n.ssid))return false;
        seen.add(n.ssid);
        return true;
      });
    $('networks').replaceChildren();
    const placeholder=document.createElement('option');
    placeholder.value='';
    placeholder.textContent=networks.length?'Chб»Ќn mбєЎng Wi-Fi ('+networks.length+' mбєЎng)':'KhГґng tГ¬m thбєҐy mбєЎng В· Nhбє­p tГЄn mбєЎng bГЄn dЖ°б»›i';
    $('networks').append(placeholder);
    for(const n of networks){
      const option=document.createElement('option');
      option.value=n.ssid;
      option.textContent=n.ssid+' ('+n.rssi+' dBm)'+(n.rssi>=-60?' В· TГ­n hiб»‡u mбєЎnh':'');
      $('networks').append(option);
    }
    $('status').textContent=networks.length?'':'KhГґng tГ¬m thбєҐy mбєЎng 2.4 GHz. CГі thб»ѓ nhбє­p tГЄn mбєЎng thб»§ cГґng.';
  }catch(e){$('status').textContent=e.message}
  finally{
    scanning=false;
    $('scan').textContent='TГ¬m lбєЎi';
    buttons();
  }
};
$('form').onsubmit=async e=>{
  e.preventDefault();
  if($('save').disabled)return;
  submitting=true;
  buttons();
  $('result').replaceChildren();
  try{
    const data={ssid:$('ssid').value,password:$('password').value,mode:'dhcp'};
    const r=await fetch('/api/setup',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
    const j=await r.json();
    if(!r.ok)throw Error(j.message);
    waiting=true;
    $('status').textContent=j.message+' Nбєїu trang mбєҐt kбєїt nб»‘i, hГЈy chuyб»ѓn sang mбєЎng mб»›i rб»“i mб»џ lбєЎi trang in. Nбєїu khГґng thГ nh cГґng, thiбєїt bб»‹ tб»± quay vб»Ѓ mбєЎng cЕ©.';
  }catch(e){
    $('status').textContent=e.message;
  }finally{
    submitting=false;
    buttons();
  }
};
async function poll(){
  try{
    const r=await fetch('/api/setup/status',{cache:'no-store'});
    const j=await r.json();
    $('firmware').textContent='Firmware '+(j.firmware||'вЂ”');
    ap=j.ap;
    document.querySelectorAll('.appwnote').forEach(e=>e.textContent=j.ap_pw_custom?'(mбє­t khбє©u riГЄng)':'(mбє­t khбє©u ' + DEFAULT_PW + ')');
    $('appwstate').textContent=j.ap_pw_custom?'Дђang dГ№ng mбє­t khбє©u riГЄng.':'Дђang dГ№ng mбє­t khбє©u mбє·c Д‘б»‹nh (' + DEFAULT_PW + ').';
    connected=j.connected;
    busy=!!(j.pending||j.busy);
    buttons();
    $('info').textContent=ap?'Дђiб»ѓm phГЎt cб»§a thiбєїt bб»‹: '+j.ap_name:connected?'Thiбєїt bб»‹ Д‘ang kбєїt nб»‘i Wi-Fi. Chб»Ќn mбєЎng khГЎc bГЄn dЖ°б»›i nбєїu muб»‘n thay Д‘б»•i.':'ChЖ°a kбєїt nб»‘i. Giб»Ї nГєt BOOT 5 giГўy Д‘б»ѓ bбє­t Д‘iб»ѓm phГЎt cГ i Д‘бє·t.';
    if((ap||connected)&&!busy&&!scanned&&!waiting&&!submitting){
      scanned=true;
      $('scan').onclick();
    }else if(!ap&&!connected)scanned=false;
    if(!waiting)return;
    if(j.pending)return;
    if(j.error){
      waiting=false;
      $('status').textContent='KhГґng kбєїt nб»‘i Д‘Ж°б»Јc. Vui lГІng kiб»ѓm tra tГЄn mбєЎng vГ  mбє­t khбє©u rб»“i thб»­ lбєЎi.';
    }else if(j.connected&&j.ip){
      waiting=false;
      $('password').value='';
      $('status').textContent='ДђГЈ kбєїt nб»‘i vГ  lЖ°u cбєҐu hГ¬nh Wi-Fi. Chuyб»ѓn Д‘iб»‡n thoбєЎi hoбє·c mГЎy tГ­nh sang mбєЎng vб»«a chб»Ќn Д‘б»ѓ mб»џ trang in. CГі thб»ѓ Д‘бє·t IP nГ y lГ m IP tД©nh.';
      const base='http://'+j.ip;
      const print=document.createElement('a');
      print.href=base+'/';
      print.textContent=print.href;
      const fixed=document.createElement('a');
      fixed.href=base+'/network';
      fixed.textContent='Дђбє·t '+j.ip+' lГ m IP tД©nh';
      $('result').replaceChildren(print,fixed);
    }
    buttons();
  }catch(e){
    if(waiting)$('status').textContent='Дђang chuyб»ѓn sang mбєЎng mб»›i. Nбєїu khГґng thГ nh cГґng, thiбєїt bб»‹ tб»± quay vб»Ѓ mбєЎng cЕ©; cГі thб»ѓ kбєїt nб»‘i Д‘iб»ѓm phГЎt ViTinhAnPhu-XXXX Д‘б»ѓ kiб»ѓm tra.';
  }
}
setInterval(poll,2000);
poll();
async function appw(pw){
  try{
    const r=await fetch('/api/setup/ap_password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({password:pw})});
    $('status').textContent=(await r.json()).message;
    if(r.ok)$('appass').value='';
  }catch(e){$('status').textContent='ДђГЈ mбєҐt kбєїt nб»‘i vГ¬ Д‘iб»ѓm phГЎt vб»«a Д‘б»•i mбє­t khбє©u. Kбєїt nб»‘i lбєЎi rб»“i kiб»ѓm tra.'}
}
$('appsave').onclick=()=>{
  const pw=$('appass').value;
  if(pw.length<8||pw.length>63){$('status').textContent='Mбє­t khбє©u phбєЈi cГі tб»« 8 Д‘бєїn 63 kГЅ tб»±.';return}
  appw(pw);
};
$('appclear').onclick=()=>appw('');
$('handover').onclick=async()=>{
  if(!confirm('XГіa toГ n bб»™ cГ i Д‘бє·t mбєЎng Д‘ГЈ lЖ°u Д‘б»ѓ bГ n giao thiбєїt bб»‹?'))return;
  try{
    const r=await fetch('/api/setup/handover',{method:'POST'});
    $('status').textContent=(await r.json()).message;
  }catch(e){$('status').textContent=e.message}
};
</script></html>
␀␀<!doctype html><html lang=vi><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'><title>GiбєҐy phГ©p mГЈ nguб»“n mб»џ</title><style>body{font:16px/1.55 system-ui;max-width:720px;margin:30px auto;padding:20px;background:#f1f6f7;color:#173239}a{color:#087e81}li{margin:6px 0}</style><h1>GiбєҐy phГ©p mГЈ nguб»“n mб»џ</h1><p><a href='/'>Trang in</a></p><p>Firmware nГ y lГ  phбє§n mб»Ѓm tб»± do, phГўn phб»‘i theo giбєҐy phГ©p <b>GNU GPL phiГЄn bбєЈn 3 hoбє·c mб»›i hЖЎn</b>, <b>khГґng cГі bбєҐt kб»і bбєЈo hГ nh nГ o</b>. BбєЎn cГі quyб»Ѓn nhбє­n mГЈ nguб»“n tЖ°ЖЎng б»©ng cб»§a bбєЈn firmware nГ y tб»« ngЖ°б»ќi cung cбєҐp thiбєїt bб»‹. ToГ n vДѓn giбєҐy phГ©p: <a href='https://www.gnu.org/licenses/gpl-3.0.html' target=_blank rel=noopener>gnu.org/licenses/gpl-3.0</a>.</p><p>XГўy dб»±ng tб»« cГЎc dб»± ГЎn mГЈ nguб»“n mб»џ:</p><ul><li>esp32-lbp2900-airprint (GPL-3.0-or-later)</li><li>esp32-usb-to-airprint, В© Xuan-Son Nguyen (MIT)</li><li>captdriver: driver Canon CAPT (GPL)</li><li>brlaser, В© Peter De Wachter: Brother laser (GPL-2.0-or-later)</li><li>JBIG-KIT, В© Markus Kuhn (GPL)</li><li>ESP-IDF, В© Espressif Systems (Apache-2.0)</li></ul><p>Dб»Ї liб»‡u khб»џi Д‘б»™ng mГЎy in HP P1006 (tбєЈi tб»« Internet khi cбє§n) lГ  thГ nh phбє§n nhб»‹ phГўn cб»§a HP, theo Д‘iб»Ѓu khoбєЈn riГЄng, khГґng thuб»™c giбєҐy phГ©p GPL.</p></html>␀␀␀␀<!doctype html><html lang=vi><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'><title>Vi TГ­nh An PhГє В· PhiГЄn bбєЈn</title><style>*{box-sizing:border-box}html{color-scheme:dark}body{font:15px/1.6 system-ui;max-width:760px;margin:0 auto;padding:32px 18px 24px;background:#080f1d;color:#ecf3ff}body:before{content:"";position:fixed;inset:0;pointer-events:none;background:radial-gradient(ellipse at 90% 0,#16395166,transparent 60%);z-index:-1}header{padding:20px 4px 18px}h1{font-size:34px;line-height:1.2;letter-spacing:-1px;margin:12px 0}h2{font-size:19px;margin:0 0 8px}p{color:#a9bad1;margin:8px 0 14px}.eyebrow{color:#65e3cc;font-size:12px;font-weight:750;letter-spacing:2px}.card{padding:24px;margin:0 0 18px;background:linear-gradient(145deg,#17253a,#101c2d);border:1px solid #2c405a;border-radius:22px;box-shadow:0 16px 35px #0003}input,button{width:100%;min-height:48px;padding:12px 14px;border-radius:12px;border:1px solid #354c68;background:#0c1728;color:#eff6ff;font:inherit}button{background:#6ce6cc;color:#071c22;border-color:transparent;font-weight:750;cursor:pointer;margin:12px 0 4px}button:hover{filter:brightness(1.08)}button:disabled{opacity:.55;cursor:wait}label.pick{display:block;text-align:center;min-height:48px;padding:12px 14px;border-radius:12px;background:#20364d;color:#8ff2e0;border:1px solid #395c72;font-weight:750;cursor:pointer;margin:12px 0 4px}label.pick:hover{filter:brightness(1.08)}.vh{position:absolute;width:1px;height:1px;opacity:0;overflow:hidden}.vh:focus+label.pick{outline:2px solid #63e6cb}button.sec{background:#20364d;color:#8ff2e0;border:1px solid #395c72}a{color:#82ebd7;text-underline-offset:4px}.ver{font-size:22px;font-weight:800;color:#ecf3ff;overflow-wrap:anywhere}.msg{padding:14px 16px;margin:12px 0 0;border:1px solid #345870;background:#112b3d;border-radius:14px;color:#d5e8ff;white-space:pre-wrap;overflow-wrap:anywhere}.msg.ok{background:#11372e;border-color:#53c9a5;color:#d9f3e9}.msg.err{background:#3a1d26;border-color:#c96a7d;color:#ffd9e0}.bar{height:12px;border-radius:8px;background:#0c1728;border:1px solid #354c68;overflow:hidden;margin:14px 0 0}.bar i{display:block;height:100%;width:0;background:#6ce6cc;transition:width .3s}.note{font-size:13px}.msg:empty,.msg[hidden]{display:none}[hidden]{display:none!important}footer{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;padding:20px 4px;color:#8fa3be;font-size:12px}@media(max-width:480px){body{padding:14px 12px}.card{padding:18px}h1{font-size:28px}}</style><header><span class=eyebrow>VI TГЌNH AN PHГљ / PHIГЉN BбєўN</span><h1>PhiГЄn bбєЈn firmware</h1><p>Дђang dГ№ng: <span class=ver id=cur>Дђang Д‘б»ЌcвЂ¦</span></p><p><a href='/'>в†ђ Vб»Ѓ trang in</a></p></header><section class=card><h2>Cбє­p nhбє­t qua Internet</h2><p>Thiбєїt bб»‹ tбєЈi bбєЈn mб»›i tб»« mГЎy chб»§ cб»§a Vi TГ­nh An PhГє vГ  kiб»ѓm tra tГ­nh toГ n vбє№n (SHA-256) trЖ°б»›c khi cГ i. Cбє§n thiбєїt bб»‹ Д‘ang kбєїt nб»‘i Wi-Fi cГі Internet.</p><button id=chk class=sec>Kiб»ѓm tra bбєЈn mб»›i</button><div id=found hidden><p>PhiГЄn bбєЈn mб»›i: <span class=ver id=lat></span></p><p id=notes style='white-space:pre-wrap'></p><button id=inst></button></div><div id=mon class=msg></div></section><section class=card><h2>Cбє­p nhбє­t tб»« file</h2><p>Chб»Ќn file firmware (.bin) do Vi TГ­nh An PhГє cung cбєҐp. Thiбєїt bб»‹ kiб»ѓm tra file trЖ°б»›c khi cГ i.</p><input id=file class=vh type=file accept='.bin'><label for=file class=pick>Chб»Ќn file firmware (.bin)</label><p class=note id=fn>ChЖ°a chб»Ќn file</p><button id=up disabled>TбєЈi lГЄn vГ  cбє­p nhбє­t</button></section><div id=prog hidden><div class=bar><i id=fill></i></div></div><div id=st class=msg role=status></div><p class=note>Дђб»ѓ bбєЈo vб»‡ thiбєїt bб»‹, giб»Ї nГєt BOOT trГЄn mбєЎch 5 giГўy rб»“i bбєҐm cбє­p nhбє­t trong vГІng 2 phГєt. Thiбєїt bб»‹ tб»± khб»џi Д‘б»™ng lбєЎi sau khi cГ i; nбєїu bбєЈn mб»›i khГґng chбєЎy Д‘Ж°б»Јc, thiбєїt bб»‹ tб»± quay vб»Ѓ bбєЈn cЕ©.</p><footer><span>Vi TГ­nh An PhГє</span><a href='/licenses'>GiбєҐy phГ©p mГЈ nguб»“n mб»џ</a></footer><script>
var $=function(i){return document.getElementById(i)},cur='',busy=false,T=null;
function say(t,k){var e=$('st');e.textContent=t||'';e.className='msg'+(k?' '+k:'')}
function bar(p){$('prog').hidden=p<0;$('fill').style.width=Math.max(0,p)+'%'}
function lock(b){busy=b;$('chk').disabled=b;$('inst').disabled=b;$('up').disabled=b||!$('file').files.length}
function get(){return fetch('/api/update',{cache:'no-store'}).then(function(r){if(!r.ok)throw 0;return r.json()})}
function post(b){return fetch('/api/update',{method:'POST',body:JSON.stringify(b)}).then(function(r){return r.json().then(function(j){return{ok:r.ok,m:j.message}})})}
function show(s){cur=s.current;$('cur').textContent=s.current;
var f=s.available;$('found').hidden=!f;
if(f){$('lat').textContent=s.latest;$('notes').textContent=s.notes||'';$('inst').textContent='Cбє­p nhбє­t lГЄn '+s.latest.split('-')[0]}
$('mon').textContent=f?'':(s.state==='checked'&&s.latest?'ДђГўy lГ  bбєЈn mб»›i nhбєҐt.':(s.state==='error'?s.message:''));
$('mon').className='msg'+(s.state==='error'?' err':(f?'':' ok'))}
function poll(){get().then(function(s){show(s);
if(s.state==='downloading'||s.state==='receiving'){lock(true);bar(s.progress);say(s.message);T=setTimeout(poll,1000)}
else if(s.state==='checking'){lock(true);say(s.message);T=setTimeout(poll,1000)}
else if(s.state==='rebooting'){wait()}
else{lock(false);bar(-1);say(s.state==='error'?s.message:'',s.state==='error'?'err':'')}}).catch(function(){T=setTimeout(poll,2000)})}
function wait(){var old=cur,down=false,n=0;lock(true);bar(100);say('ДђГЈ ghi xong. Thiбєїt bб»‹ Д‘ang khб»џi Д‘б»™ng lбєЎi, vui lГІng chб»ќвЂ¦');
(function t(){fetch('/api/update',{cache:'no-store'}).then(function(r){if(!r.ok)throw 0;return r.json()}).then(function(s){
if(down||s.current!==old){show(s);lock(false);bar(-1);say('ДђГЈ cбє­p nhбє­t. PhiГЄn bбєЈn Д‘ang dГ№ng: '+s.current,'ok')}else{n++;if(n>6){show(s);lock(false);bar(-1);say('Thiбєїt bб»‹ chЖ°a khб»џi Д‘б»™ng lбєЎi. TбєЈi lбєЎi trang Д‘б»ѓ kiб»ѓm tra.','err')}else setTimeout(t,2000)}
}).catch(function(){down=true;if(++n>90){lock(false);bar(-1);say('KhГґng thбєҐy thiбєїt bб»‹ phбєЈn hб»“i. Kiб»ѓm tra nguб»“n vГ  kбєїt nб»‘i Wi-Fi, rб»“i tбєЈi lбєЎi trang.','err')}else setTimeout(t,2000)})})()}
$('chk').onclick=function(){say('');lock(true);post({action:'check'}).then(function(r){if(!r.ok){lock(false);say(r.m,'err')}else poll()}).catch(function(){lock(false);say('KhГґng gб»­i Д‘Ж°б»Јc yГЄu cбє§u.','err')})};
$('inst').onclick=function(){if(!confirm('Cбє­p nhбє­t lГЄn '+$('lat').textContent+'? Thiбєїt bб»‹ sбєЅ khб»џi Д‘б»™ng lбєЎi sau khi cГ i.'))return;say('');lock(true);post({action:'install'}).then(function(r){if(!r.ok){lock(false);say(r.m,'err')}else{bar(0);poll()}}).catch(function(){lock(false);say('KhГґng gб»­i Д‘Ж°б»Јc yГЄu cбє§u.','err')})};
$('file').onchange=function(){say('');var f=$('file').files[0];$('fn').textContent=f?f.name+' ('+(f.size>=1048576?(f.size/1048576).toFixed(2)+' MB':Math.ceil(f.size/1024)+' KB')+')':'ChЖ°a chб»Ќn file';$('up').disabled=busy||!$('file').files.length};
$('up').onclick=function(){var f=$('file').files[0];if(!f)return;
if(!confirm('CГ i file '+f.name+'? Thiбєїt bб»‹ sбєЅ khб»џi Д‘б»™ng lбєЎi sau khi cГ i.'))return;
say('Дђang tбєЈi file lГЄnвЂ¦');lock(true);bar(0);var x=new XMLHttpRequest();x.open('POST','/api/update/upload');
x.upload.onprogress=function(e){if(e.lengthComputable)bar(Math.round(e.loaded*100/e.total))};
x.onload=function(){var j={};try{j=JSON.parse(x.responseText)}catch(e){}
if(x.status===200&&j.ok){say('ДђГЈ cГ i bбєЈn '+(j.version||'mб»›i')+'. Thiбєїt bб»‹ Д‘ang khб»џi Д‘б»™ng lбєЎiвЂ¦');wait()}else{lock(false);bar(-1);say(j.message||'Cбє­p nhбє­t khГґng thГ nh cГґng.','err')}};
x.onerror=function(){lock(false);bar(-1);say('MбєҐt kбєїt nб»‘i khi tбєЈi file. Thiбєїt bб»‹ vбє«n dГ№ng bбєЈn hiб»‡n tбєЎi.','err')};
x.send(f)};
poll();
</script></html>␀␀␀␀255.255.255.0␀␀␀␀␀␀␀␀␀␀␀1.1.1.1␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀<!doctype html><html lang=vi><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'><title>CГ i Д‘бє·t IP ESP 32</title><style>body{font:17px system-ui;max-width:620px;margin:30px auto;padding:20px;background:#f3f7fa}label{display:block;margin:14px 0}input,select,button{font:inherit;padding:10px;box-sizing:border-box;width:100%;border:1px solid #acbdc8;border-radius:8px}button{background:#087e81;color:white}a{color:#087e81}small{display:block}</style><nav><a href='/'>Trang in</a> В· <a href='/setup'>Дђб»•i Wi-Fi</a></nav>
<h1>Дђб»‹a chб»‰ IP</h1>
<p id=current>Дђang Д‘б»Ќc Д‘б»‹a chб»‰ IPвЂ¦</p>
<form id=form>
<label>Chбєї Д‘б»™ IP<select id=mode disabled><option value=dhcp>IP Д‘б»™ng (DHCP)</option><option value=static>IP tД©nh вЂ” giб»Ї IP Д‘ang dГ№ng</option></select></label>
<p id=preview></p>
<button id=save disabled>LЖ°u chбєї Д‘б»™ IP</button>
</form>
<p id=status role=status></p>
<script>
const $=id=>document.getElementById(id);
let current='', loaded=false, saving=false;
function render(){
  const fixed=$('mode').value==='static';
  $('preview').textContent=fixed
    ? (current ? 'ESP sбєЅ giб»Ї IP '+current+' lГ m IP tД©nh.' : 'ESP chЖ°a nhбє­n IP tб»« router.')
    : 'Router sбєЅ tб»± cбєҐp IP cho ESP.';
  $('save').disabled=!loaded||saving||(fixed&&!current);
}
$('mode').onchange=render;
fetch('/api/network',{cache:'no-store'}).then(async r=>{
  if(!r.ok)throw Error('KhГґng Д‘б»Ќc Д‘Ж°б»Јc cбєҐu hГ¬nh IP.');
  const config=await r.json();
  current=config.current;
  $('current').textContent=current?'IP Д‘ang dГ№ng: '+current:'ESP chЖ°a cГі Д‘б»‹a chб»‰ IP.';
  $('mode').value=config.mode;
  $('mode').disabled=false;
  loaded=true;
  render();
}).catch(e=>$('status').textContent=e.message);
$('form').onsubmit=async e=>{
  e.preventDefault();
  if($('save').disabled)return;
  saving=true;
  render();
  $('status').textContent='Дђang lЖ°uвЂ¦';
  try{
    const r=await fetch('/api/network',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({mode:$('mode').value})});
    const config=await r.json();
    if(!r.ok)throw Error(config.message);
    $('status').textContent=config.message;
    if(config.url){
      const link=document.createElement('a');
      link.href=config.url;
      link.textContent=' Mб»џ trang in';
      $('status').append(link);
    }
  }catch(e){
    $('status').textContent=e.message;
    saving=false;
    render();
  }
};
</script></html>
␀<!doctype html><html lang=vi><meta charset=utf-8><meta name=viewport content='width=device-width,initial-scale=1'><title>Nhбє­t kГЅ mГЎy in</title><style>body{font:16px system-ui;margin:0;background:#f1f5f9;color:#163044}main{max-width:1000px;margin:auto;padding:24px}a,button{display:inline-block;padding:12px 16px;margin:4px;border:0;border-radius:10px;background:#087e81;color:white;text-decoration:none;font:inherit;cursor:pointer}pre{background:#102332;color:#e6f5f3;padding:16px;border-radius:12px;white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.6 monospace}label{display:block;margin:16px 0}</style><main><a href='/'>в†ђ Trang in</a><h1>Nhбє­t kГЅ vГ  chбє©n Д‘oГЎn</h1><p>Log tб»± thu khi ESP khб»џi Д‘б»™ng. Nбєїu in lб»—i, tбєЈi bГЎo cГЎo rб»“i gб»­i lбєЎi Д‘б»ѓ kiб»ѓm tra.</p><a href='/diagnostics.txt' download='printserver-log.txt'>TбєЈi bГЎo cГЎo lб»—i (.txt)</a><button id=refresh>LГ m mб»›i</button><a href='/diagnostics/coredump' download='printserver-crash.elf'>TбєЈi crash dump</a><label><input type=checkbox id=auto checked> Tб»± cбє­p nhбє­t mб»—i 3 giГўy</label><p>Log giб»Ї phбє§n gбє§n nhбєҐt trong bб»™ Д‘б»‡m vГІng 64 KB. ДђuГґi log cГі thб»ѓ cГІn sau reset/watchdog; mбєҐt Д‘iб»‡n sбєЅ mбєҐt log RAM. HГЈy tбєЈi trЖ°б»›c khi rГєt nguб»“n. Crash dump chб»‰ cГі nбєїu ESP Д‘ГЈ ghi Д‘Ж°б»Јc mб»™t lбє§n crash.</p><p id=status>Дђang Д‘б»ЌcвЂ¦</p><pre id=report></pre></main><script>const report=document.getElementById('report'),statusEl=document.getElementById('status'),refresh=document.getElementById('refresh');let busy=false;async function update(){if(busy)return;busy=true;try{const r=await fetch('/diagnostics.txt',{cache:'no-store'});if(!r.ok)throw Error('HTTP '+r.status);report.textContent=await r.text();statusEl.textContent='Cбє­p nhбє­t: '+new Date().toLocaleTimeString()}catch(e){statusEl.textContent='KhГґng Д‘б»Ќc Д‘Ж°б»Јc log: '+e.message}finally{busy=false}}refresh.onclick=update;setInterval(()=>{if(document.getElementById('auto').checked)update()